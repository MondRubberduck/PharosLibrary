# user config (contains local paths)
service/asset_service/pharos_config.json

# derived data (regenerated by the importers / renderers)
*.sqlite*
registry/*.sqlite*
previews/
*.bak*
*.log

# kept on disk for the owner, deliberately out of the public repo:
# host-app bridge + its deploy/test tooling, environment probe, generated
# reports, and the private engineering history.
# Exception to the no-kiosk-names rule: the "kiosk" names below are on-disk
# filenames, not labels we chose -- renaming an ignore line would un-ignore
# the real file on disk, so the ignore entries must keep matching them.
extensions/
reports/
tools/deploy_kiosk.py
tools/inspect_environment.py
tests/test_extension.py
docs/decisions.md
docs/HANDOVER_COMPLETE.md
docs/environment-notes.md

# OS noise
Thumbs.db
desktop.ini
.DS_Store
pipeline/agent_index/aa_meta.json

# pipeline runtime scratch: worklists, index runs, engine logs and the
# UE sandbox copy carry absolute local paths (and multi-GB content) --
# never publishable, always regenerable
pipeline/conversion/logs/
pipeline/conversion/status/
pipeline/conversion/sandbox/
pipeline/native/native_manifest.json
pipeline/native/native_blends.txt
pipeline/native/native_index_*.jsonl
pipeline/agent_index/tex_meta.json
pipeline/agent_index/aliases.json
pipeline/agent_index/audio_overrides.json
